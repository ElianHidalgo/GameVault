<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GameVault.LoginPage">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="🎮 GameVault"
                FontSize="30"
                HorizontalOptions="Center"/>

            <Entry
                x:Name="txtCorreo"
                Placeholder="Correo electrónico"
                Keyboard="Email"/>

            <Entry
                x:Name="txtPassword"
                Placeholder="Contraseña"
                IsPassword="True"/>

            <Label
                Text="Mostrar contraseña"/>
            
            <CheckBox
                x:Name="chkMostrar"/>
            
            <Label
                Text="Recordarme"/>


            <CheckBox
                x:Name="chkRecordar"/>
            <Button
                Text="Iniciar Sesión"
                Clicked="Login_Clicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>